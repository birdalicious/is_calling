@implements IDisposable

<div id="background">
	<div id="profile">
		<img src="./assets/images/john-pork-1.jpg" />
		<h2>John Pork</h2>

		<h5>@GetTime()</h5>
	</div>

	<div class="button" @onclick="EndCall">
		<img src="./assets/images/end-call-icon.png" />
	</div>
</div>

<AudioHelper @ref="_audio" Src="./assets/audio/femur.mp3" Type="audio/mpeg" />

@code {
	private int _seconds = 0;

	private Timer _timer;
	private Timer _audioDelay;
	private AudioHelper _audio;

	[Parameter]
	public EventCallback OnCallEnd { get; set; }

	private string GetTime()
	{
		return $"{_seconds / 60:00}:{_seconds % 60:00}";
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if(firstRender)
		{
			_timer = new Timer(_ => { _seconds++; StateHasChanged(); }, null, 0, 1000);
			_audioDelay = new Timer(async _ => await _audio.Start(), null, 1000, 0);
		}
	}

	public void Dispose()
	{
		_timer.Dispose();
		_audioDelay.Dispose();
	}

	private async Task EndCall()
	{
		await _audio.Stop();
		await OnCallEnd.InvokeAsync();
	}
}