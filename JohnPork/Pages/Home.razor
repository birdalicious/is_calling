@page "/"

<PageTitle>Home</PageTitle>

<div class="home-page">
	@if (_state == State.None)
	{
		<div class="full" @onclick="Start">
		<p>Press to start</p>
		</div>
	}

	@if (_state == State.Declined)
	{
		<div class="full" @onclick="Start">
		</div>
	}

	@if (_state == State.Calling)
	{
		<JohnPork.Components.Calling OnDecline="() => _state = State.Declined" OnAccept="() => _state = State.Accepted" />
	}

	@if (_state == State.Accepted)
	{
		<JohnPork.Components.Call OnCallEnd="() => _state = State.Declined" />
	}
</div>

@code {
	private enum State
	{
		None,
		Calling,
		Declined,
		Accepted,
	}

	private State _state = State.None;

	private void Start()
	{
		if (_state != State.Calling && _state != State.Accepted)
		{
			_state = State.Calling;
		}
	}
}
